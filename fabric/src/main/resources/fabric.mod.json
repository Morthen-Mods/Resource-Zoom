{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${mod_author}" ],
  "contact": {
    "homepage": "${sources_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",
  "environment": "client",
  "entrypoints": {
    "client": [ "net.morthen.resource_zoom.ZoomClient" ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "~26.1",
    "java": ">=${java_version}"
  }
}
